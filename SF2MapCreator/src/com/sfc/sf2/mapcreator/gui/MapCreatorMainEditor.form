                                        <Component class="javax.swing.JButton" name="jButtonOptimise">
                                          <Properties>
                                            <Property name="text" type="java.lang.String" value="Optimise and Generate Data"/>
                                          </Properties>
                                          <Events>
                                            <EventHandler event="actionPerformed" listener="java.awt.event.ActionListener" parameters="java.awt.event.ActionEvent" handler="jButtonOptimiseActionPerformed"/>
                                          </Events>
                                        </Component>
                                        <Component class="javax.swing.JLabel" name="jLabel38">
                                          <Properties>
                                            <Property name="text" type="java.lang.String" value="&lt;html&gt;- Orphaned Tiles: Any tiles that do not fit in the original tilesets.&lt;br&gt;Use the checkbox to see where the orphaned tiles are on the map.&lt;br&gt;&lt;br&gt;&#xa;- Optimized Blockset: Identifies all unique blocks on the map in order of appearance (i.e. duplicates are combined).&lt;br&gt;&lt;br&gt;&#xa;- New Tileset: Any orphaned tiles will be inserted into blank tiles spaces in the new tilesets.&lt;br&gt;Empty tilesets will be filled to create new tilesets.&lt;/html&gt;"/>
                                            <Property name="verticalAlignment" type="int" value="1"/>
                                          </Properties>
                                        </Component>
                                        <Component class="javax.swing.JComboBox" name="jComboBoxFillMode">
                                          <Properties>
                                            <Property name="model" type="javax.swing.ComboBoxModel" editor="org.netbeans.modules.form.editors2.ComboBoxModelEditor">
                                              <StringArray count="3">
                                                <StringItem index="0" value="New Only"/>
                                                <StringItem index="1" value="New First"/>
                                                <StringItem index="2" value="Existing First"/>
                                              </StringArray>
                                            </Property>
                                            <Property name="name" type="java.lang.String" value="Action Fill Mode Combo" noResource="true"/>
                                          </Properties>
                                          <Events>
                                            <EventHandler event="actionPerformed" listener="java.awt.event.ActionListener" parameters="java.awt.event.ActionEvent" handler="jComboBoxFillModeActionPerformed"/>
                                          </Events>
                                          <AuxValues>
                                            <AuxValue name="JavaCodeGenerator_TypeParameters" type="java.lang.String" value="&lt;String&gt;"/>
                                          </AuxValues>
                                        </Component>
                                        <Component class="com.sfc.sf2.core.gui.controls.InfoButton" name="infoButton4">
                                          <Properties>
                                            <Property name="messageText" type="java.lang.String" value="&lt;html&gt;- &lt;b&gt;Fill new only:&lt;/b&gt; Will only create new tilesets. Will not modifiy any existing tilesets. Left over tilesets will be &apos;orphaned&apos;.&lt;br&gt;&lt;br&gt;- &lt;b&gt;New first:&lt;/b&gt; Will create and fill new tilesets first, then will fill empty spaces in existing tilesets.&lt;br&gt;&lt;br&gt;- &lt;b&gt;Existing first:&lt;/b&gt; Will fill spaces in existing tilesets first, then will create and fill new tilesets.&lt;/html&gt;"/>
                                            <Property name="text" type="java.lang.String" value=""/>
                                          </Properties>
                                        </Component>
                                        <Component class="javax.swing.JLabel" name="jLabel3">
                                          <Properties>
                                            <Property name="text" type="java.lang.String" value="Fill mode :"/>
                                          </Properties>
                                        </Component>
