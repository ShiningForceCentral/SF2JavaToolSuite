                                            <Property name="text" type="java.lang.String" value="&lt;html&gt;&lt;b&gt;Step 3:&lt;/b&gt; Fill existing tilesets or create new tilesets.&lt;/html&gt;"/>
                                            <Property name="verticalAlignment" type="int" value="1"/>
                                          </Properties>
