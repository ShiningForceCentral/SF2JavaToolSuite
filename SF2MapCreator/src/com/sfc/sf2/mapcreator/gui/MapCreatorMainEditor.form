                                            <Component class="com.sfc.sf2.core.gui.controls.FileButton" name="fileButtonImportImage">
                                              <Properties>
                                                <Property name="fileFormatFilter" type="com.sfc.sf2.core.io.FileFormat" editor="org.netbeans.modules.form.editors.EnumEditor">
                                                  <Value id="ANY_IMAGE"/>
                                                </Property>
                                                <Property name="filePath" type="java.lang.String" value="./export/layout.png"/>
                                                <Property name="infoMessage" type="java.lang.String" value="&lt;html&gt;An image of the map to import.&lt;br&gt;&lt;b&gt;Image requirements :&lt;/b&gt;&lt;br&gt;- Dimensions: 64x64 map blocks = 1536x1536 pixels&lt;br&gt;- Image format: 16-color indexed (4bpp) - 256-color indexed tolerated if only first 16 colors are used.&lt;br&gt;&lt;br&gt;Note: Color at index 0 should be transparent. All used colors from the palette should have distinct values, to avoid color index ambiguity.&lt;/html&gt;"/>
                                                <Property name="labelText" type="java.lang.String" value="Map image :"/>
                                              </Properties>
                                            </Component>
                                            <Component class="com.sfc.sf2.core.gui.controls.FileButton" name="fileButtonImportLayout">
                                              <Properties>
                                                <Property name="fileFormatFilter" type="com.sfc.sf2.core.io.FileFormat" editor="org.netbeans.modules.form.editors.EnumEditor">
                                                  <Value id="TXT"/>
                                                </Property>
                                                <Property name="filePath" type="java.lang.String" value="./export/layout_flags.txt"/>
                                                <Property name="infoMessage" type="java.lang.String" value="&lt;html&gt;(Optional) Layout flags indicates the map flags on each map block - i.e. to identify search points, stairs, warp points, etc.&lt;br&gt;&lt;br&gt;Generally, this data would be exported from an existing map in the MapEditor.&lt;br&gt;This data can be modified in the MapEditor once this map is created.&lt;/hml&gt;"/>
                                                <Property name="labelText" type="java.lang.String" value="Layout flags :"/>
                                              </Properties>
                                            </Component>
                                            <Component class="com.sfc.sf2.core.gui.controls.FileButton" name="fileButtonImportHp">
                                              <Properties>
                                                <Property name="fileFormatFilter" type="com.sfc.sf2.core.io.FileFormat" editor="org.netbeans.modules.form.editors.EnumEditor">
                                                  <Value id="TXT"/>
                                                </Property>
                                                <Property name="filePath" type="java.lang.String" value="./export/layout_hptiles.txt"/>
                                                <Property name="infoMessage" type="java.lang.String" value="&lt;html&gt;(Optional) HP tiles indicates which tiles are drawn on the &apos;high priority&apos; layer - i.e. drawn over the top of mapsprites.&lt;br&gt;&lt;br&gt;Generally, this data would be exported from an existing map in the MapEditor.&lt;br&gt;This data can be modified in the MapEditor once this map is created.&lt;/hml&gt;"/>
                                                <Property name="labelText" type="java.lang.String" value="HP tiles :"/>
                                              </Properties>
                                            </Component>
